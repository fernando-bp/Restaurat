"""
Pagos Bold/Bre-B por QR dinamico.

Este archivo concentra la implementacion pedida para no tocar el resto del POS.
La confirmacion del pago reutiliza la logica de pagos ya desarrollada:
Pago -> PagoRepoSQLAlchemy -> OrdenRepoSQLAlchemy -> MesaRepoSQLAlchemy.

Para exponerlo en FastAPI se puede incluir `pagos_boll_router` en el router v1.
"""


APPROVED_EVENTS = {"SALE_APPROVED", "PAYMENT_APPROVED", "APPROVED"}
REJECTED_EVENTS = {"SALE_REJECTED", "PAYMENT_REJECTED", "REJECTED", "DECLINED", "FAILED"}
PENDING_STATUSES = {"PENDING", "CREATED", "PROCESSING", "PENDIENTE"}


class PagoBoldIntentORM(Base):
    __tablename__ = "bold_payment_intents"
    __table_args__ = {"extend_existing": True}

    id = Column(Integer, primary_key=True, autoincrement=True)
    orden_id = Column(Integer, nullable=False, index=True)
    mesa_id = Column(Integer, nullable=True, index=True)
    cajero_id = Column(Integer, nullable=True)
    monto = Column(DECIMAL(14, 0), nullable=False)
    moneda = Column(String(3), nullable=False, default="COP")
    referencia = Column(String(120), nullable=False, unique=True, index=True)
    bold_payment_id = Column(String(120), unique=True, index=True)
    estado = Column(String(20), nullable=False, default="PENDIENTE", index=True)
    metodo_pago = Column(String(30), nullable=False, default="QR_BREB")
    qr_payload = Column(Text)
    webhook_id = Column(String(120), unique=True, index=True)
    ultimo_error = Column(String(500))
    created_at = Column(DateTime, nullable=False, default=datetime.utcnow)
    expires_at = Column(DateTime)
    updated_at = Column(DateTime, nullable=False, default=datetime.utcnow, onupdate=datetime.utcnow)


class CrearPagoBoldQrDTO(BaseModel):
    orden_id: int = Field(..., gt=0)
    mesa_id: int | None = Field(None, gt=0)
    monto: Decimal | None = Field(None, gt=0)
    payer_name: str | None = None


class PagoBoldQrDTO(BaseModel):
    id: int
    orden_id: int
    mesa_id: int | None
    monto: Decimal
    moneda: str
    referencia: str
    bold_payment_id: str | None
    estado: str
    metodo_pago: str
    qr_payload: str | None
    expires_at: datetime | None
    created_at: datetime

    class Config:
        from_attributes = True


class WebhookBoldResponseDTO(BaseModel):
    ok: bool
    status: str
    intent_id: int | None = None
    message: str | None = None


class PagoBoldError(RuntimeError):
    pass


@dataclass(frozen=True)
class PagoBoldConfig:
    api_base_url: str
    api_key: str
    webhook_secret: str
    verify_signature: bool
    expiration_minutes: int

    @classmethod
    def from_settings(cls) -> "PagoBoldConfig":
        return cls(
            api_base_url=getattr(settings, "bold_api_base_url", "https://api.bold.co"),
            api_key=getattr(settings, "bold_api_key", ""),
            webhook_secret=getattr(settings, "bold_webhook_secret", ""),
            verify_signature=getattr(settings, "bold_webhook_verify_signature", True),
            expiration_minutes=getattr(settings, "bold_qr_expiration_minutes", 15),
        )


class PagoBoldClient:
    def __init__(self, config: PagoBoldConfig):
        self.config = config
        self.base_url = config.api_base_url.rstrip("/")

    def _headers(self) -> dict[str, str]:
        return {
            "Authorization": f"x-api-key {self.config.api_key}",
            "Content-Type": "application/json",
        }

    async def crear_qr_dinamico(
        self,
        *,
        monto: Decimal,
        referencia: str,
        payer_name: str | None,
    ) -> dict[str, Any]:
        if not self.config.api_key:
            raise PagoBoldError("BOLD_API_KEY no esta configurada")

        payload: dict[str, Any] = {
            "amount": {
                "currency": "COP",
                "total_amount": int(monto),
            },
            "reference": referencia,
            "payment_method": {"type": "QR_BREB"},
        }
        if payer_name:
            payload["payer"] = {"name": payer_name}

        async with httpx.AsyncClient(timeout=20) as client:
            response = await client.post(
                f"{self.base_url}/online/payments/v1/payment_intents",
                json=payload,
                headers=self._headers(),
            )

        if response.status_code >= 400:
            raise PagoBoldError(f"Bold rechazo la intencion QR: {response.text}")
        return response.json()

    async def consultar_intencion(self, bold_payment_id: str) -> dict[str, Any]:
        if not self.config.api_key:
            raise PagoBoldError("BOLD_API_KEY no esta configurada")

        async with httpx.AsyncClient(timeout=20) as client:
            response = await client.get(
                f"{self.base_url}/online/payments/v1/payment_intents/{bold_payment_id}",
                headers=self._headers(),
            )

        if response.status_code >= 400:
            raise PagoBoldError(f"No se pudo confirmar el pago en Bold: {response.text}")
        return response.json()


class PagoBoldRepository:
    def __init__(self, session: AsyncSession):
        self.session = session

    async def crear(self, intent: PagoBoldIntentORM) -> PagoBoldIntentORM:
        self.session.add(intent)
        await self.session.commit()
        await self.session.refresh(intent)
        return intent

    async def obtener_por_id(self, intent_id: int) -> PagoBoldIntentORM | None:
        result = await self.session.execute(
            select(PagoBoldIntentORM).where(PagoBoldIntentORM.id == intent_id)
        )
        return result.scalar_one_or_none()

    async def obtener_por_referencia(self, referencia: str) -> PagoBoldIntentORM | None:
        result = await self.session.execute(
            select(PagoBoldIntentORM).where(PagoBoldIntentORM.referencia == referencia)
        )
        return result.scalar_one_or_none()

    async def obtener_por_pago_bold(self, bold_payment_id: str) -> PagoBoldIntentORM | None:
        result = await self.session.execute(
            select(PagoBoldIntentORM).where(PagoBoldIntentORM.bold_payment_id == bold_payment_id)
        )
        return result.scalar_one_or_none()

    async def obtener_por_webhook(self, webhook_id: str) -> PagoBoldIntentORM | None:
        result = await self.session.execute(
            select(PagoBoldIntentORM).where(PagoBoldIntentORM.webhook_id == webhook_id)
        )
        return result.scalar_one_or_none()

    async def guardar(self, intent: PagoBoldIntentORM) -> PagoBoldIntentORM:
        await self.session.commit()
        await self.session.refresh(intent)
        return intent


class PagoBoldQrService:
    def __init__(self, session: AsyncSession, config: PagoBoldConfig | None = None):
        self.session = session
        self.config = config or PagoBoldConfig.from_settings()
        self.repo = PagoBoldRepository(session)
        self.orden_repo = OrdenRepoSQLAlchemy(session)
        self.pago_repo = PagoRepoSQLAlchemy(session)
        self.mesa_repo = MesaRepoSQLAlchemy(session)
        self.client = PagoBoldClient(self.config)

    async def crear_intencion_qr(
        self,
        *,
        orden_id: int,
        mesa_id: int | None,
        monto: Decimal | None,
        cajero_id: int | None,
        payer_name: str | None,
    ) -> PagoBoldIntentORM:
        orden = await self.orden_repo.obtener_por_id(orden_id)
        if not orden:
            raise ValueError(f"Orden {orden_id} no encontrada")
        if orden.estado in (EstadoOrdenEnum.PAGADA, EstadoOrdenEnum.CANCELADA):
            raise ValueError("La orden no esta disponible para pago")

        pagos = await self.pago_repo.listar_por_orden(orden_id)
        total_pagado = sum(Decimal(p.monto or 0) for p in pagos)
        saldo = Decimal(orden.total_neto or 0) - total_pagado
        valor_qr = (monto or saldo).quantize(Decimal("1"))

        if valor_qr <= 0:
            raise ValueError("La orden no tiene saldo pendiente")
        if valor_qr > saldo:
            raise ValueError("El monto supera el saldo pendiente de la orden")

        effective_mesa_id = mesa_id or orden.mesa_id
        referencia = self._crear_referencia(orden_id, effective_mesa_id)
        respuesta_bold = await self.client.crear_qr_dinamico(
            monto=valor_qr,
            referencia=referencia,
            payer_name=payer_name or f"Cliente Mesa {effective_mesa_id}",
        )

        intent = PagoBoldIntentORM(
            orden_id=orden_id,
            mesa_id=effective_mesa_id,
            cajero_id=cajero_id,
            monto=valor_qr,
            moneda="COP",
            referencia=self._obtener_referencia(respuesta_bold, referencia),
            bold_payment_id=self._obtener_payment_id(respuesta_bold),
            estado=self._normalizar_estado(respuesta_bold.get("status")),
            metodo_pago="QR_BREB",
            qr_payload=self._obtener_qr_payload(respuesta_bold),
            expires_at=self._parse_datetime(respuesta_bold.get("expires_at"))
            or datetime.utcnow() + timedelta(minutes=self.config.expiration_minutes),
        )
        return await self.repo.crear(intent)

    async def consultar_intencion(self, intent_id: int) -> PagoBoldIntentORM | None:
        intent = await self.repo.obtener_por_id(intent_id)
        if not intent:
            return None

        if intent.estado == "PENDIENTE" and intent.expires_at and intent.expires_at < datetime.utcnow():
            intent.estado = "EXPIRADO"
            return await self.repo.guardar(intent)

        return intent

    async def procesar_webhook(self, evento: dict[str, Any]) -> tuple[PagoBoldIntentORM | None, str]:
        webhook_id = evento.get("id")
        if webhook_id:
            existente = await self.repo.obtener_por_webhook(webhook_id)
            if existente:
                return existente, "duplicate"

        data = evento.get("data") or {}
        referencia = self._extraer_referencia_evento(data)
        payment_id = data.get("payment_id") or data.get("payment_intent_id") or data.get("id")

        intent = None
        if referencia:
            intent = await self.repo.obtener_por_referencia(referencia)
        if intent is None and payment_id:
            intent = await self.repo.obtener_por_pago_bold(str(payment_id))
        if intent is None:
            return None, "not_found"

        tipo_evento = str(evento.get("type") or "").upper()
        if tipo_evento in REJECTED_EVENTS:
            intent.estado = "RECHAZADO"
            intent.webhook_id = webhook_id
            await self.repo.guardar(intent)
            return intent, "rejected"

        if tipo_evento not in APPROVED_EVENTS:
            return intent, "ignored"

        self._validar_monto_webhook(intent, data)
        if not await self._confirmar_con_bold(intent):
            intent.ultimo_error = "Bold no confirmo el pago como aprobado"
            await self.repo.guardar(intent)
            return intent, "not_confirmed"

        await self._registrar_pago_en_pos(intent, webhook_id)
        return intent, "approved"

    async def _registrar_pago_en_pos(self, intent: PagoBoldIntentORM, webhook_id: str | None) -> None:
        if intent.estado == "APROBADO":
            return

        pago = Pago(
            id=None,
            orden_id=intent.orden_id,
            forma_pago=FormaPagoEnum.QR_BREB,
            monto=Decimal(intent.monto),
            numero_comprobante=intent.bold_payment_id or intent.referencia,
            cajero_id=intent.cajero_id,
            created_at=datetime.utcnow(),
        )
        pago.validar_transferencia()
        await self.pago_repo.guardar(pago)

        orden = await self.orden_repo.obtener_por_id(intent.orden_id)
        if orden:
            pagos = await self.pago_repo.listar_por_orden(intent.orden_id)
            total_pagado = sum(Decimal(p.monto or 0) for p in pagos)
            if total_pagado >= Decimal(orden.total_neto or 0):
                orden.estado = EstadoOrdenEnum.PAGADA
                orden.hora_cierre = datetime.utcnow()
                await self.orden_repo.guardar(orden)

                mesa = await self.mesa_repo.obtener_por_id(orden.mesa_id)
                if mesa:
                    mesa.estado = "libre"
                    await self.mesa_repo.guardar(mesa)

        intent.estado = "APROBADO"
        intent.webhook_id = webhook_id
        await self.repo.guardar(intent)

    async def _confirmar_con_bold(self, intent: PagoBoldIntentORM) -> bool:
        if not intent.bold_payment_id:
            return True
        try:
            respuesta = await self.client.consultar_intencion(intent.bold_payment_id)
        except PagoBoldError:
            return False
        return self._normalizar_estado(respuesta.get("status")) == "APROBADO"

    def _validar_monto_webhook(self, intent: PagoBoldIntentORM, data: dict[str, Any]) -> None:
        amount_data = data.get("amount") or {}
        amount = amount_data.get("total") or amount_data.get("total_amount")
        currency = amount_data.get("currency") or intent.moneda

        if currency != intent.moneda:
            raise ValueError("La moneda del webhook no coincide")
        if amount is not None and Decimal(str(amount)).quantize(Decimal("1")) != Decimal(intent.monto):
            raise ValueError("El monto del webhook no coincide")

    def _crear_referencia(self, orden_id: int, mesa_id: int | None) -> str:
        suffix = uuid4().hex[:6].upper()
        return f"ORD-{orden_id}-MESA-{mesa_id or 'NA'}-{datetime.utcnow():%Y%m%d%H%M%S}-{suffix}"

    def _normalizar_estado(self, status_value: Any) -> str:
        value = str(status_value or "PENDING").upper()
        if value in APPROVED_EVENTS or value == "APROBADO":
            return "APROBADO"
        if value in REJECTED_EVENTS or value == "RECHAZADO":
            return "RECHAZADO"
        if value in {"EXPIRED", "EXPIRADO"}:
            return "EXPIRADO"
        if value in PENDING_STATUSES:
            return "PENDIENTE"
        return "PENDIENTE"

    def _parse_datetime(self, value: str | None) -> datetime | None:
        if not value:
            return None
        return datetime.fromisoformat(value.replace("Z", "+00:00")).replace(tzinfo=None)

    def _obtener_payment_id(self, response: dict[str, Any]) -> str | None:
        return response.get("payment_intent_id") or response.get("payment_id") or response.get("id")

    def _obtener_referencia(self, response: dict[str, Any], fallback: str) -> str:
        metadata = response.get("metadata") or {}
        return response.get("reference") or metadata.get("reference") or fallback

    def _obtener_qr_payload(self, response: dict[str, Any]) -> str | None:
        qr_data = response.get("qr") or {}
        return (
            response.get("qr_payload")
            or response.get("qr_code")
            or response.get("qr_url")
            or qr_data.get("payload")
            or qr_data.get("url")
        )

    def _extraer_referencia_evento(self, data: dict[str, Any]) -> str | None:
        metadata = data.get("metadata") or {}
        return metadata.get("reference") or data.get("reference")


def verificar_firma_bold(raw_body: bytes, signature: str | None, secret: str) -> bool:
    if not signature or not secret:
        return False
    expected = hmac.new(secret.encode("utf-8"), raw_body, sha256).hexdigest()
    normalized = signature.removeprefix("sha256=").strip()
    return hmac.compare_digest(expected, normalized)


pagos_boll_router = APIRouter(prefix="/pagos-boll", tags=["pagos-boll"])


@pagos_boll_router.post("/qr-dinamico", response_model=PagoBoldQrDTO, status_code=201)
async def crear_pago_transferencia_qr_dinamico(
    payload: CrearPagoBoldQrDTO,
    current_user: dict = Depends(get_current_user),
    db: AsyncSession = Depends(get_db_session),
) -> PagoBoldQrDTO:
    if current_user.get("rol") not in ("cajero", "administrador", "admin"):
        raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail="No autorizado")

    try:
        intent = await PagoBoldQrService(db).crear_intencion_qr(
            orden_id=payload.orden_id,
            mesa_id=payload.mesa_id,
            monto=payload.monto,
            cajero_id=current_user.get("id"),
            payer_name=payload.payer_name,
        )
    except PagoBoldError as exc:
        raise HTTPException(status_code=status.HTTP_502_BAD_GATEWAY, detail=str(exc)) from exc
    except ValueError as exc:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(exc)) from exc

    return PagoBoldQrDTO.model_validate(intent)


@pagos_boll_router.get("/qr-dinamico/{intent_id}", response_model=PagoBoldQrDTO)
async def consultar_pago_transferencia_qr_dinamico(
    intent_id: int,
    current_user: dict = Depends(get_current_user),
    db: AsyncSession = Depends(get_db_session),
) -> PagoBoldQrDTO:
    if current_user.get("rol") not in ("cajero", "administrador", "admin"):
        raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail="No autorizado")

    intent = await PagoBoldQrService(db).consultar_intencion(intent_id)
    if not intent:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="Pago QR no encontrado")
    return PagoBoldQrDTO.model_validate(intent)


@pagos_boll_router.post("/webhook", response_model=WebhookBoldResponseDTO)
async def recibir_webhook_pago_bold(
    request: Request,
    x_bold_signature: str | None = Header(None),
    db: AsyncSession = Depends(get_db_session),
) -> WebhookBoldResponseDTO:
    config = PagoBoldConfig.from_settings()
    raw_body = await request.body()

    if config.verify_signature:
        if not verificar_firma_bold(raw_body, x_bold_signature, config.webhook_secret):
            raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="Firma Bold invalida")

    try:
        evento = json.loads(raw_body.decode("utf-8"))
    except json.JSONDecodeError as exc:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="JSON invalido") from exc

    try:
        intent, result = await PagoBoldQrService(db, config).procesar_webhook(evento)
    except ValueError as exc:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(exc)) from exc

    return WebhookBoldResponseDTO(
        ok=True,
        status=result,
        intent_id=intent.id if intent else None,
        message="Webhook procesado",
    )
